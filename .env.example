ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Secret the Discord bot sends to create changelog entries via POST /api/changelog
CHANGELOG_API_KEY=replace-this-with-a-long-random-changelog-bot-key
# MySQL URL of the Neptune leaderboard database (server-only; plain mysql:// or the plugin's jdbc:mysql:// form)
LEADERBOARD_DATABASE_URL=mysql://user:password@host:3306/database
